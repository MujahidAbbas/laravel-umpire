{
    "name": "mujahidabbas/laravel-umpire",
    "description": "Per-tool Gate authorization, tool-call audit events and a safe stale-client purge for laravel/mcp servers.",
    "keywords": [
        "laravel",
        "mcp",
        "model-context-protocol",
        "authorization",
        "audit",
        "gate",
        "oauth"
    ],
    "homepage": "https://github.com/MujahidAbbas/laravel-umpire",
    "license": "MIT",
    "authors": [
        {
            "name": "Mujahid Abbas",
            "homepage": "https://mujahidabbas.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/mcp": "^1.1",
        "symfony/uid": "^7.4|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/passport": "^13.10",
        "laravel/pint": "^1.29",
        "laravel/sanctum": "^4.3",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.6|^5.0",
        "pestphp/pest-plugin-laravel": "^4.1|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0|^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "MujahidAbbas\\Umpire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MujahidAbbas\\Umpire\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": "vendor/bin/pint --parallel",
        "lint:check": "vendor/bin/pint --parallel --test",
        "analyse": "vendor/bin/phpstan analyse",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "test:unit": "vendor/bin/pest --parallel",
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "MujahidAbbas\\Umpire\\UmpireServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
